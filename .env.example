# Existing .env is preserved; never commit real credentials.
OPENAI_API_KEY=your-api-key
WP_URL=https://msnewsgroup.com
WP_USERNAME=your-editor-user
WP_APP_PASSWORD=your-application-password
EXTRACTION_MODEL=gpt-5-nano
DRAFTING_MODEL=gpt-5.6-luna
PUBLISH_MODE=auto
MAX_POSTS_PER_RUN=10
MAX_ENTRIES_PER_FEED=25
MAX_AGE_HOURS=24
POLL_INTERVAL_MINUTES=15
DATABASE_PATH=./processed.db
IMAGE_DIR=./images
REVIEW_DIR=./review
# Map these fixed editorial categories to existing WordPress category IDs.
# No categories are created automatically. Exact-name lookup is the fallback.
CATEGORY_IDS_JSON={}
# feeds.txt remains primary and is read as UTF-8 with optional BOM.
# Set FEEDS_FILE or SOURCES_FILE only to override their locations.
